# Copy to .env and fill in real values. Never commit .env.
DB_URL=jdbc:mysql://host.docker.internal:3306/order_management
DB_USERNAME=order_app
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-app-password
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
REDIS_HOST=redis
REDIS_PORT=6379
